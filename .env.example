# Kopieer naar .env en vul je sleutel in. .env staat in .gitignore, dit bestand niet.
ANTHROPIC_API_KEY=sk-ant-...

# Upload naar Google Drive (optioneel; alleen nodig als je met een Drive-map draait).
# De app maakt bij de eerste run zelf de map "Herschreven trainingen" aan in je Mijn Drive en
# print de id. Zet die hier neer, dan slaat elke volgende run het zoeken over. De map mag je
# daarna in Drive verplaatsen, hernoemen en delen; de koppeling loopt via de id.
DRIVE_ROOT_ID=
# Paden relatief aan deze map. De client-JSON download je uit de Google Cloud Console
# (OAuth-client van het type "Desktop app"); het token schrijft de code zelf weg.
GOOGLE_CLIENT_SECRET=google_client_secret.json
GOOGLE_TOKEN=google_token.json
